[Unit]
Description=Dank Lookup force-press trigger (Magic Trackpad)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 %h/.local/bin/dank-force-press-watch --cmd %h/.local/bin/dank-lookup-selection
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
