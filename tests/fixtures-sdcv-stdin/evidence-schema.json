{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dank-lookup.invalid/schemas/sdcv-stdin-gate-v2.json",
  "title": "dank-lookup sdcv 0.5.5 stdin feasibility evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "verdict",
    "sdcv_version",
    "sdcv_version_raw",
    "sdcv_version_returncode",
    "stdout_cap_bytes",
    "stderr_cap_bytes",
    "history_environment",
    "history_paths",
    "gate_errors",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "sdcv_0_5_5_stdin_feasibility_gate"},
    "verdict": {"enum": ["pass", "fail"]},
    "sdcv_version": {"type": "string"},
    "sdcv_version_raw": {"type": "string"},
    "sdcv_version_returncode": {"type": "integer"},
    "stdout_cap_bytes": {"const": 67108864},
    "stderr_cap_bytes": {"const": 1048576},
    "history_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SDCV_HISTFILE", "SDCV_HISTSIZE"],
      "properties": {
        "SDCV_HISTFILE": {"const": "/dev/null"},
        "SDCV_HISTSIZE": {"const": "0"}
      }
    },
    "history_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "gate_errors": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "cases": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {"$ref": "#/$defs/case"},
      "allOf": [
        {"contains": {"$ref": "#/$defs/exact_hit"}, "minContains": 1, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/exact_miss"}, "minContains": 1, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/fuzzy_choice"}, "minContains": 1, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/single_dictionary"}, "minContains": 1, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/multiple_dictionaries"}, "minContains": 1, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/unicode_en"}, "minContains": 1, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/unicode_han"}, "minContains": 1, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/unicode_ja"}, "minContains": 1, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/unicode_yue"}, "minContains": 1, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/stdin_eof_after_exact"}, "minContains": 1, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/stdin_eof_at_main_prompt"}, "minContains": 1, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/source_timeout"}, "minContains": 1, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/overall_timeout"}, "minContains": 1, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/cancellation"}, "minContains": 1, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/stdout_under_cap_32mib"}, "minContains": 1, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/stdout_over_cap"}, "minContains": 1, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/stderr_over_cap"}, "minContains": 1, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/sentinel_cmdline"}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"verdict": {"const": "pass"}},
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "sdcv_version_raw": {"minLength": 1}
        }
      }
    }
  ],
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "argv_metadata",
        "query_bytes",
        "choice",
        "pid",
        "returncode",
        "duration_ms",
        "termination_reason",
        "stdout_bytes",
        "stdout_stored_bytes",
        "stderr_bytes",
        "stderr_stored_bytes",
        "stdout_cap_bytes",
        "stderr_cap_bytes",
        "stdout_file",
        "stderr_file",
        "cmdline_file",
        "query_in_cmdline",
        "main_prompt_count",
        "choice_prompt_count",
        "process_group_reaped",
        "runner_decisions",
        "errors",
        "status"
      ],
      "properties": {
        "name": {
          "enum": [
            "exact_hit",
            "exact_miss",
            "fuzzy_choice",
            "single_dictionary",
            "multiple_dictionaries",
            "unicode_en",
            "unicode_han",
            "unicode_ja",
            "unicode_yue",
            "stdin_eof_after_exact",
            "stdin_eof_at_main_prompt",
            "source_timeout",
            "overall_timeout",
            "cancellation",
            "stdout_under_cap_32mib",
            "stdout_over_cap",
            "stderr_over_cap",
            "sentinel_cmdline"
          ]
        },
        "argv_metadata": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "query_bytes": {"type": "integer", "minimum": 0},
        "choice": {"type": ["integer", "null"]},
        "pid": {"type": "integer", "minimum": 1},
        "returncode": {"type": "integer"},
        "duration_ms": {"type": "number", "minimum": 0},
        "termination_reason": {
          "enum": [null, "timeout", "cancelled", "stdout_cap", "stderr_cap", "wait_timeout"]
        },
        "stdout_bytes": {"type": "integer", "minimum": 0},
        "stdout_stored_bytes": {"type": "integer", "minimum": 0},
        "stderr_bytes": {"type": "integer", "minimum": 0},
        "stderr_stored_bytes": {"type": "integer", "minimum": 0},
        "stdout_cap_bytes": {"const": 67108864},
        "stderr_cap_bytes": {"const": 1048576},
        "stdout_file": {"type": "string", "minLength": 1},
        "stderr_file": {"type": "string", "minLength": 1},
        "cmdline_file": {"type": ["string", "null"]},
        "query_in_cmdline": {"type": "boolean"},
        "main_prompt_count": {"type": "integer", "minimum": 0},
        "choice_prompt_count": {"type": "integer", "minimum": 0},
        "process_group_reaped": {"type": "boolean"},
        "runner_decisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "parser": {"$ref": "#/$defs/parser"},
        "sentinel_environment_match": {"type": "boolean"},
        "errors": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "status": {"enum": ["pass", "fail"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"name": {"const": "sentinel_cmdline"}},
            "required": ["name"]
          },
          "then": {
            "required": ["sentinel_environment_match"],
            "properties": {"cmdline_file": {"type": "string", "minLength": 1}}
          },
          "else": {
            "properties": {"cmdline_file": {"const": null}},
            "not": {"required": ["sentinel_environment_match"]}
          }
        }
      ]
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisions",
        "entry_count",
        "headwords",
        "dictionaries",
        "definition_chars",
        "definition_sha256",
        "options"
      ],
      "properties": {
        "decisions": {"type": "array", "items": {"type": "string"}},
        "entry_count": {"type": "integer", "minimum": 0},
        "headwords": {"type": "array", "items": {"type": "string"}},
        "dictionaries": {"type": "array", "items": {"type": "string"}},
        "definition_chars": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "definition_sha256": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "options": {
          "type": "array",
          "items": {"$ref": "#/$defs/option"}
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "dictionary", "word"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "dictionary": {"type": "string"},
        "word": {"type": "string"}
      }
    },
    "exact_hit": {"properties": {"name": {"const": "exact_hit"}}, "required": ["name"]},
    "exact_miss": {"properties": {"name": {"const": "exact_miss"}}, "required": ["name"]},
    "fuzzy_choice": {"properties": {"name": {"const": "fuzzy_choice"}}, "required": ["name"]},
    "single_dictionary": {"properties": {"name": {"const": "single_dictionary"}}, "required": ["name"]},
    "multiple_dictionaries": {"properties": {"name": {"const": "multiple_dictionaries"}}, "required": ["name"]},
    "unicode_en": {"properties": {"name": {"const": "unicode_en"}}, "required": ["name"]},
    "unicode_han": {"properties": {"name": {"const": "unicode_han"}}, "required": ["name"]},
    "unicode_ja": {"properties": {"name": {"const": "unicode_ja"}}, "required": ["name"]},
    "unicode_yue": {"properties": {"name": {"const": "unicode_yue"}}, "required": ["name"]},
    "stdin_eof_after_exact": {"properties": {"name": {"const": "stdin_eof_after_exact"}}, "required": ["name"]},
    "stdin_eof_at_main_prompt": {"properties": {"name": {"const": "stdin_eof_at_main_prompt"}}, "required": ["name"]},
    "source_timeout": {"properties": {"name": {"const": "source_timeout"}}, "required": ["name"]},
    "overall_timeout": {"properties": {"name": {"const": "overall_timeout"}}, "required": ["name"]},
    "cancellation": {"properties": {"name": {"const": "cancellation"}}, "required": ["name"]},
    "stdout_under_cap_32mib": {"properties": {"name": {"const": "stdout_under_cap_32mib"}}, "required": ["name"]},
    "stdout_over_cap": {"properties": {"name": {"const": "stdout_over_cap"}}, "required": ["name"]},
    "stderr_over_cap": {"properties": {"name": {"const": "stderr_over_cap"}}, "required": ["name"]},
    "sentinel_cmdline": {"properties": {"name": {"const": "sentinel_cmdline"}}, "required": ["name"]}
  }
}
