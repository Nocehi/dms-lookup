{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dank-lookup.invalid/schemas/sdcv-stdin-gate-v1.json",
  "title": "dank-lookup sdcv 0.5.5 stdin feasibility evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "verdict",
    "sdcv_version",
    "stdout_cap_bytes",
    "history_environment",
    "history_paths",
    "gate_errors",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "sdcv_0_5_5_stdin_feasibility_gate"},
    "verdict": {"enum": ["pass", "fail"]},
    "sdcv_version": {"type": "string"},
    "stdout_cap_bytes": {"type": "integer", "minimum": 1},
    "history_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SDCV_HISTFILE", "SDCV_HISTSIZE"],
      "properties": {
        "SDCV_HISTFILE": {"const": "/dev/null"},
        "SDCV_HISTSIZE": {"const": "0"}
      }
    },
    "history_paths": {"type": "array", "items": {"type": "string"}},
    "gate_errors": {"type": "array", "items": {"type": "string"}},
    "cases": {
      "type": "array",
      "minItems": 17,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "name",
        "argv_metadata",
        "query_bytes",
        "pid",
        "returncode",
        "duration_ms",
        "termination_reason",
        "stdout_bytes",
        "stdout_stored_bytes",
        "stderr_bytes",
        "stdout_cap_bytes",
        "stdout_file",
        "stderr_file",
        "process_group_reaped",
        "runner_decisions",
        "errors",
        "status"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "argv_metadata": {"type": "array", "items": {"type": "string"}},
        "query_bytes": {"type": "integer", "minimum": 0},
        "choice": {"type": ["integer", "null"]},
        "pid": {"type": "integer", "minimum": 1},
        "returncode": {"type": ["integer", "null"]},
        "duration_ms": {"type": "number", "minimum": 0},
        "termination_reason": {
          "enum": [null, "timeout", "cancelled", "stdout_cap", "wait_timeout"]
        },
        "stdout_bytes": {"type": "integer", "minimum": 0},
        "stdout_stored_bytes": {"type": "integer", "minimum": 0},
        "stderr_bytes": {"type": "integer", "minimum": 0},
        "stdout_cap_bytes": {"type": "integer", "minimum": 1},
        "stdout_file": {"type": "string", "minLength": 1},
        "stderr_file": {"type": "string", "minLength": 1},
        "cmdline_file": {"type": ["string", "null"]},
        "query_in_cmdline": {"type": "boolean"},
        "main_prompt_count": {"type": "integer", "minimum": 0},
        "choice_prompt_count": {"type": "integer", "minimum": 0},
        "process_group_reaped": {"type": "boolean"},
        "runner_decisions": {"type": "array", "items": {"type": "string"}},
        "parser": {"type": "object"},
        "sentinel_environment_match": {"type": "boolean"},
        "errors": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["pass", "fail"]}
      }
    }
  }
}
